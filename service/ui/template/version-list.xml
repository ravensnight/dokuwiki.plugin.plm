<div id="{{ctx}}"
    hx-get="{{PREFIX}}versions"
    hx-trigger="part_select from:body"
    hx-vals="js:{partId: event.detail.id}"
    hx-target="#{{ctx}}"
    hx-swap="innerHTML">
        
    <table class="">
        <thead class="">
            <tr class="">
                <th id="id">ID</th>
                <th name="name">Name</th>
                <th major="major">Major Version</th>
                <th revision="revision">Revision</th>
                <th status="status">Status</th>
            </tr>
        </thead>
        <tbody class="">
            <!-- Loop: $partVersion -->
            <tr class="">
                <td id="id">{{ $v->pk }}</td>
                <td name="name">
                    <a href="/doku.php?plmapi=v1/versions/{{ $v->pk }}" 
                    hx-get="/doku.php?plmapi=v1/versions/{{ $v->pk }}" 
                    hx-target="#versionedit" 
                    hx-swap="innerHTML" 
                    class="">{{ $v->name }}</a>
                </td>
                <td major="major">{{ $v->major }}</td>
                <td revision="revision">{{ $v->revision }}</td>
                <td status="status">{{ $status->name }}</td>
            </tr>
        </tbody>
    </table>
</div>